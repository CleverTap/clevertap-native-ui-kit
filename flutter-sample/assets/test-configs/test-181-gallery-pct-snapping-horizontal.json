{
  "version": "1.0",
  "root": {
    "type": "container",
    "id": "root",
    "containerType": "vertical",
    "layout": {
      "width": {
        "value": 100,
        "unit": "percent"
      },
      "padding": {
        "all": 12
      },
      "arrangement": {
        "strategy": "spaced",
        "spacing": 12,
        "spacingUnit": "dp"
      }
    },
    "children": [
      {
        "type": "element",
        "id": "header",
        "elementType": "text",
        "bindings": {
          "text": "Featured Workouts"
        },
        "style": {
          "textColor": "#111111",
          "fontSize": 20,
          "lineHeight": 26,
          "fontWeight": "bold"
        },
        "layout": {
          "width": {
            "value": 100,
            "unit": "percent"
          }
        }
      },
