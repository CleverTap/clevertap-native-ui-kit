        "type": "container",
        "id": "gallery",
        "containerType": "gallery",
        "layout": {
          "width": {
            "value": 100,
            "unit": "percent"
          },
          "aspectRatio": 1.5
        },
        "galleryConfig": {
          "mode": "snapping",
          "orientation": "horizontal",
          "itemsPerView": 1,
          "spacing": 12,
          "showIndicators": true,
          "autoScrollInterval": 3000,
          "initialPage": 0,
          "indicatorStyle": {
            "activeColor": "#2196F3",
            "inactiveColor": "#D0D0D0",
