{
  "theme": {
    "id": "default"
  },
  "version": "1.0",
  "root": {
    "type": "container",
    "id": "root",
    "containerType": "box",
    "layout": {
      "aspectRatio": 1.3,
      "width": {
        "value": 90,
        "unit": "percent"
      },
      "height": {
        "value": 70,
        "unit": "percent"
      },
      "padding": {
        "all": 0
      }
    },
    "style": {
      "background": {
        "type": "linear_gradient",
        "angle": 135,
        "colors": [
          "#e0f2fe",
          "#ffffff"
        ]
      },
      "borderRadius": {
        "value": 8,
        "unit": "percent"
      },
      "borderColor": "#38bdf8",
      "borderWidth": 4,
      "shadowColor": "#33000000",
      "shadowRadius": 12,
      "shadowOffsetX": 0,
      "shadowOffsetY": 4
    },
    "children": [
      {
        "type": "element",
        "id": "title",
        "elementType": "text",
        "bindings": {
          "text": "Rounded corners wrap every element"
        },
        "layout": {
          "width": {
            "value": 92,
            "unit": "percent"
          },
          "height": {
            "value": 14,
            "unit": "percent"
          },
          "offset": {
            "x": 4,
            "y": 5,
            "unit": "percent"
          }
        },
        "style": {
          "fontSize": {
            "value": 120,
            "unit": "percent"
          },
          "fontWeight": "bold",
          "textAlign": "center",
          "textColor": "#0c4a6e"
        }
      },
      {
        "type": "element",
        "id": "image",
        "elementType": "image",
        "bindings": {
          "url": "https://yavuzceliker.github.io/sample-images/image-10.jpg"
        },
        "imageConfig": {
          "fit": "crop"
        },
        "layout": {
          "width": {
            "value": 88,
            "unit": "percent"
          },
          "height": {
            "value": 46,
            "unit": "percent"
          },
          "offset": {
            "x": 6,
            "y": 22,
            "unit": "percent"
          }
        },
        "style": {
          "borderRadius": {
            "value": 6,
            "unit": "percent"
          }
        }
      },
      {
        "type": "element",
        "id": "button",
        "elementType": "button",
        "bindings": {
          "text": "Shop Now"
        },
        "layout": {
          "width": {
            "value": 50,
            "unit": "percent"
          },
          "height": {
            "value": 13,
            "unit": "percent"
          },
          "offset": {
            "x": 25,
            "y": 72,
            "unit": "percent"
          }
        },
        "style": {
          "background": {
            "type": "linear_gradient",
            "angle": 90,
            "colors": [
              "#0284c7",
              "#0ea5e9"
            ]
          },
          "borderRadius": {
            "value": 20,
            "unit": "percent"
          },
          "fontSize": {
            "value": 100,
            "unit": "percent"
          },
          "fontWeight": "bold",
          "textColor": "#FFFFFF"
        },
        "actions": {
          "onClick": {
            "type": "custom",
            "key": "shop_tap",
            "value": 1
          }
        }
      },
      {
        "type": "element",
        "id": "divider",
        "elementType": "divider",
        "dividerConfig": {
          "orientation": "horizontal",
          "thickness": 2,
          "color": "#38bdf8"
        },
        "layout": {
          "width": {
            "value": 80,
            "unit": "percent"
          },
          "height": {
            "value": 2,
            "unit": "percent"
          },
          "offset": {
            "x": 10,
            "y": 90,
            "unit": "percent"
          }
        }
      }
    ]
  }
}
